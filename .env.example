# Leave OBSIDIAN_VAULT empty when this project is placed inside your Obsidian Vault.
# Example explicit path:
# OBSIDIAN_VAULT=C:\Users\name\OneDrive\Documents\Obsidian Vault
OBSIDIAN_VAULT=
PORT=3050

# If the project itself is inside <Vault>\Книги, the server auto-detects Книги as the books directory.
BOOKS_DIR=Books
PDF_DIR=Attachments/Books
ACHIEVEMENTS_FILE=Achievements.md
APP_TITLE=Bookroom
USER_NAME=
DEFAULT_LANGUAGE=ru
DEFAULT_THEME=dark

BOOKROOM_DIR=Bookroom
TOPICS_DIR=Topics
ACHIEVEMENTS_DIR=Achievements
FOLDERS_DIR=Folders
GRAPH_FILE=Bookroom/Graph.md
INDEX_FILE=Bookroom/Index.md
CANVAS_FILE=Bookroom/Network.canvas
